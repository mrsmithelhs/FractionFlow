{
  "version": "1.0.0",
  "routes": [
    {
      "id": "ROUTE-TRAVERSAL-VISUAL-NO-DISPATCH",
      "behavior": "A learner completes a full addition problem visually from encounter to reflect using mounted UI controls with zero dispatch fallback.",
      "configuration": "phase2-bundle-1",
      "startingSurface": "mounted-app-entry",
      "viewport": { "width": 360, "height": 740 },
      "motionMode": "standard-motion",
      "witness": "browser",
      "actions": [
        { "step": 1, "method": "click", "target": ".app-visual-view .control-btn", "description": "Acknowledge encounter" },
        { "step": 2, "method": "click", "target": ".app-visual-view .control-choice-btn >> nth=1", "description": "Notice: choose different sized parts" },
        { "step": 3, "method": "click", "target": ".app-visual-view .control-choice-btn >> nth=0", "description": "Decide: choose common denominator 12" },
        { "step": 4, "method": "fill", "target": ".app-visual-view input.control-numeric-input", "value": "8", "description": "Transform left: enter numerator 8" },
        { "step": 5, "method": "click", "target": ".app-visual-view .control-submit-btn", "description": "Transform left: submit 8" },
        { "step": 6, "method": "fill", "target": ".app-visual-view input.control-numeric-input", "value": "3", "description": "Transform right: enter numerator 3" },
        { "step": 7, "method": "click", "target": ".app-visual-view .control-submit-btn", "description": "Transform right: submit 3" },
        { "step": 8, "method": "fill", "target": ".app-visual-view input.control-numeric-input", "value": "11", "description": "Operate: enter sum 11" },
        { "step": 9, "method": "click", "target": ".app-visual-view .control-submit-btn", "description": "Operate: submit 11" },
        { "step": 10, "method": "click", "target": ".app-visual-view .control-btn", "description": "Resolve: acknowledge completed operation" }
      ],
      "expect": {
        "capture": {
          "target": ".app-visual-view",
          "type": "innerHTML"
        },
        "assertions": [
          { "type": "containsText", "target": ".app-visual-view", "value": "Common denominator: 12 — the smallest one." },
          { "type": "hasSelector", "target": ".app-visual-view .matching-choice-btn" }
        ]
      },
      "negativeControl": {
        "targetRouteId": "INITIAL-ENCOUNTER-BASELINE",
        "comparison": "notIdenticalCapture"
      }
    },
